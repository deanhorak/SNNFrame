{
  "network_name": "EMNIST_V1_Visual_Processing",
  "manifest": {
    "$BASE_DIR": ".",
    "$NETWORK_DIR": "$BASE_DIR/networks"
  },
  "networks": {
    "nodes": [],
    "edges": []
  },
  "snnframe": {
    "neuron_params": {
      "cortical_default": {
        "window_size_ms": 500.0,
        "similarity_threshold": 1.0,
        "max_reference_patterns": 500,
        "similarity_metric": "cosine"
      },
      "input_neuron": {
        "window_size_ms": 500.0,
        "similarity_threshold": 1.0,
        "max_reference_patterns": 500,
        "similarity_metric": "cosine"
      },
      "output_neuron": {
        "window_size_ms": 500.0,
        "similarity_threshold": 1.0,
        "max_reference_patterns": 500,
        "similarity_metric": "cosine"
      }
    },
    "input_layer": {
      "name": "InputGrid",
      "rows": 28,
      "cols": 28,
      "latency_ms": 15.0,
      "pixel_threshold": 0.36,
      "neuron_params": {
        "window_size_ms": 500.0,
        "similarity_threshold": 1.0,
        "max_reference_patterns": 500
      }
    },
    "output_layer": {
      "name": "OutputLayer",
      "num_classes": 26,
      "neurons_per_class": 4,
      "neuron_params": {
        "window_size_ms": 500.0,
        "similarity_threshold": 1.0,
        "max_reference_patterns": 500
      }
    },
    "brain": {
      "name": "Visual Processing Network",
      "hemispheres": [
        {
          "name": "Left Hemisphere",
          "lobes": [
            {
              "name": "Occipital Lobe",
              "regions": [
                {
                  "name": "Primary Visual Cortex (V1)",
                  "nuclei": [
                    {
                      "name": "V1 Multi-Column Nucleus",
                      "column_template": {
                        "template_name": "CorticalMicroCircuit",
                        "naming_pattern": "Orient_{orientation}_Freq_{frequency}",
                        "orientations": [
                          0,
                          15,
                          30,
                          45,
                          60,
                          75,
                          90,
                          105,
                          120,
                          135,
                          150,
                          165
                        ],
                        "frequencies": [
                          0.8,
                          1.6,
                          3.2
                        ],
                        "layers": [
                          {
                            "name": "L1",
                            "populations": [
                              {
                                "name": "L1_modulatory",
                                "count": 32,
                                "neuron_params": "cortical_default"
                              }
                            ]
                          },
                          {
                            "name": "L2_3",
                            "populations": [
                              {
                                "name": "L2_3_pyramidal",
                                "count": 448,
                                "neuron_params": "cortical_default"
                              }
                            ]
                          },
                          {
                            "name": "L4",
                            "populations": [
                              {
                                "name": "L4_stellate",
                                "count": 49,
                                "neuron_params": "cortical_default",
                                "grid_layout": "7x7"
                              }
                            ]
                          },
                          {
                            "name": "L5",
                            "populations": [
                              {
                                "name": "L5_pyramidal",
                                "count": 80,
                                "neuron_params": "cortical_default"
                              }
                            ]
                          },
                          {
                            "name": "L6",
                            "populations": [
                              {
                                "name": "L6_corticothalamic",
                                "count": 32,
                                "neuron_params": "cortical_default"
                              }
                            ]
                          }
                        ]
                      }
                    }
                  ]
                }
              ]
            }
          ]
        }
      ]
    },
    "projections": [
      {
        "name": "Input_to_L4",
        "source": "InputGrid",
        "target": "V1/*/L4",
        "pattern": "tiled_receptive_field",
        "tiles_per_side": 4,
        "tiles_per_column": 3,
        "input_grid_size": 28,
        "target_grid_size": 7,
        "weight": 0.1,
        "max_weight": 0.5,
        "delay": 1.5,
        "scope": "intra_column",
        "synapse_group": "InputToL4"
      },
      {
        "name": "L4_to_L2_3",
        "source": "V1/*/L4",
        "target": "V1/*/L2_3",
        "pattern": "random_sparse",
        "probability": 0.25,
        "weight": 0.1,
        "max_weight": 0.5,
        "delay": 1.0,
        "scope": "intra_column",
        "synapse_group": ""
      },
      {
        "name": "L4_to_L5",
        "source": "V1/*/L4",
        "target": "V1/*/L5",
        "pattern": "random_sparse",
        "probability": 0.004,
        "weight": 0.1,
        "max_weight": 0.5,
        "delay": 1.0,
        "scope": "intra_column",
        "synapse_group": "L4ToL5"
      },
      {
        "name": "L2_3_to_L5",
        "source": "V1/*/L2_3",
        "target": "V1/*/L5",
        "pattern": "random_sparse",
        "probability": 0.004,
        "weight": 0.1,
        "max_weight": 0.5,
        "delay": 1.0,
        "scope": "intra_column",
        "synapse_group": ""
      },
      {
        "name": "L5_to_L6",
        "source": "V1/*/L5",
        "target": "V1/*/L6",
        "pattern": "random_sparse",
        "probability": 0.3,
        "weight": 0.1,
        "max_weight": 0.5,
        "delay": 1.0,
        "scope": "intra_column",
        "synapse_group": ""
      },
      {
        "name": "L6_to_L4_feedback",
        "source": "V1/*/L6",
        "target": "V1/*/L4",
        "pattern": "random_sparse",
        "probability": 0.25,
        "weight": 0.1,
        "max_weight": 0.5,
        "delay": 1.5,
        "scope": "intra_column",
        "synapse_group": ""
      },
      {
        "name": "L5_to_Output",
        "source": "V1/*/L5",
        "target": "OutputLayer",
        "pattern": "random_sparse",
        "probability": 0.01,
        "weight": 0.02,
        "max_weight": 0.5,
        "delay": 1.5,
        "scope": "global",
        "synapse_group": "L5ToOutput"
      }
    ],
    "gabor": {
      "freq_low": 8.0,
      "freq_high": 3.0,
      "sigma": 2.0,
      "gamma": 0.5,
      "threshold": 0.5,
      "kernel_size": 7
    },
    "saccades": {
      "enabled": true,
      "num_fixations": 4,
      "regions": [
        {
          "name": "top",
          "row_start": 0,
          "row_end": 13,
          "col_start": 0,
          "col_end": 27
        },
        {
          "name": "bottom",
          "row_start": 14,
          "row_end": 27,
          "col_start": 0,
          "col_end": 27
        },
        {
          "name": "center",
          "row_start": 7,
          "row_end": 20,
          "col_start": 7,
          "col_end": 20
        },
        {
          "name": "full",
          "row_start": 0,
          "row_end": 27,
          "col_start": 0,
          "col_end": 27
        }
      ]
    },
    "simulation": {
      "spike_processor": {
        "time_slices": 10000,
        "threads": 24,
        "real_time_sync": false
      },
      "stdp": {
        "enabled": true,
        "ltd_scale": 0.3,
        "ltd_window_ms": 70.0,
        "trace_stdp": true,
        "freeze_during_testing": true,
        "eligibility_gate": true,
        "eligibility_min_updates": 1,
        "eligibility_min_ltp": 0,
        "eligibility_threshold": -0.002,
        "eligibility_ltd_penalty": 0.5
      },
      "competition": {
        "l4_keep": 8,
        "l5_keep": 8,
        "enable_similarity_competition": true,
        "l4_similarity_weight": 0.25,
        "l5_similarity_weight": 0.6,
        "enable_l5_inhibition": true,
        "enable_l5_inter_column_inhibition": true,
        "l5_inter_column_inhibit": 0.02,
        "l5_inter_column_min_overlap": 0.3,
        "l5_inter_column_winner_scale": 0.5,
        "l5_inter_column_max_inhibit": 0.35,
        "l5_inter_column_max_orientation_delta_deg": 90.0,
        "l5_inter_column_max_frequency_octave_delta": 2.0,
        "l5_inter_column_max_neighbors": 64,
        "mask_min_active": 6
      },
      "inter_image_gap_ms": 550.0
    },
    "adapters": [
      {
        "name": "retina_l4",
        "type": "retina",
        "role": "sensory",
        "bind_to": "input",
        "temporal_window_ms": 15.0,
        "double_params": {
          "edge_threshold": 0.15,
          "frequency_blur_base_sigma": 0.6,
          "neuron_window_size": 200.0,
          "neuron_threshold": 0.7,
          "timing_jitter": 0.0,
          "min_spike_interval": 5.0,
          "input_second_weight": 0.55,
          "input_third_weight": 0.2,
          "input_blend": 0.7,
          "input_region_floor": 0.25
        },
        "int_params": {
          "grid_size": 7,
          "max_frequency_bands_per_feature": 1,
          "num_orientations": 12,
          "neuron_max_patterns": 100,
          "kernel_size": 5,
          "precision_mode": 0
        },
        "string_params": {
          "edge_operator": "sobel",
          "encoding_strategy": "temporal"
        }
      }
    ]
  }
}
